# Copia este archivo como .env y llena los valores. El .env NO se sube a git.
# En AWS no se usa .env: las credenciales de RDS viven en Secrets Manager.

AWS_REGION=
DYNAMODB_TABLA_LECTURAS=lecturas

# Solo en AWS: nombres de los secretos en Secrets Manager. En local se dejan vacíos.
RDS_SECRET_NAME=
TOKEN_SECRET_NAME=

# Solo en local: llave para firmar los tokens de sesión (mínimo 32 caracteres).
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
TOKEN_SECRET=

# --- Solo para desarrollo local con Docker (docker compose up -d) ---
# DynamoDB Local. En AWS esta variable NO se define.
DYNAMODB_ENDPOINT_URL=http://localhost:8000

# Postgres local (en lugar de RDS).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inagri
# Usuario limitado que usan las Lambdas (lo crea sql/02_usuario.sql).
DB_USER=inagri_app
DB_PASSWORD=
# Administrador del contenedor (solo para crear tablas y usuarios).
DB_ADMIN_USER=inagri_admin
DB_ADMIN_PASSWORD=
